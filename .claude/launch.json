{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "madad-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "madad-supabase",
      "runtimeExecutable": "npx",
